# Copy to .env and fill in. Never commit the real .env.

# --- LLM (backend, required) ---------------------------------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Comma-separated fallback chain; the first reachable model wins.
OPENROUTER_MODEL=openai/gpt-5.6-sol-20260709,openai/gpt-5.6-terra-20260709

# --- Server --------------------------------------------------------------
PORT=8080

# --- Knowledge base (backend) --------------------------------------------
# Folder holding the press-release archive. The indexer looks for a PR/
# subfolder inside it (either <root>/PR or <root>/新聞稿產生器/PR).
# Only meaningful when the server runs on the machine that has the archive.
PR_SOURCE_PATH=C:\Users\ChenVivi\OneDrive - Six Continents Hotels, Inc\Desktop\Claude

# --- LINE LIFF (frontend, optional) --------------------------------------
# From https://developers.line.biz/console/ → your LINE Login channel → LIFF.
# The LIFF app's Endpoint URL must match where this site is served, e.g.
#   https://press.ictaiwan.net
# Your shareable link is then: https://liff.line.me/<VITE_LIFF_ID>
# Leave blank to keep 分享到 LINE working via LINE's plain share URL.
VITE_LIFF_ID=
